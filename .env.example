# JobTracker Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# NUWorks (disabled from the normal workflow)
# =============================================================================
# Kept only for possible future use. Leave this false unless you explicitly
# want the Selenium + Duo login path.
NUWORKS_ENABLED=false
NUWORKS_USERNAME=
NUWORKS_PASSWORD=

# =============================================================================
# Adzuna API (Optional) — free ~1000 calls/month; daily backbone
# Get free credentials at: https://developer.adzuna.com/
# =============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
MAX_ADZUNA_CALLS=20

# =============================================================================
# JSearch / RapidAPI (Optional) — free ~200 calls/month; use sparingly
# =============================================================================
JSEARCH_API_KEY=
# JSEARCH_HOST=jsearch.p.rapidapi.com
# JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com/search
MAX_JSEARCH_CALLS=8

# =============================================================================
# Daily search schedule (America/New_York by default)
# =============================================================================
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=America/New_York

# Optional email notifications (leave blank to keep dashboard-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# =============================================================================
# User Profile
# =============================================================================
# Path to your resume (used for reference, not uploaded anywhere)
RESUME_PATH=

# Your GitHub profile URL
GITHUB_URL=

# Default profile settings (used on first run)
DEFAULT_NAME=Job Seeker
DEFAULT_GITHUB_URL=
DEFAULT_TARGET_ROLE=Data Engineer / Analytics Engineer — Full-Time New Grad

# =============================================================================
# Profile Matcher Configuration (Optional)
# =============================================================================
# Override skills and negative keywords as JSON:
# PROFILE_MATCHER_SKILLS='{"python": 15, "java": 10}'
# PROFILE_MATCHER_NEGATIVE_KEYWORDS='{"senior": -8}'
# PROFILE_MATCHER_MAX_SCORE=150

# =============================================================================
# Application Settings
# =============================================================================
# Flask secret key (generate a random string for production)
SECRET_KEY=your-secret-key-change-in-production

# Database URL (default: SQLite in instance folder)
# DATABASE_URL=sqlite:///jobs.db

# Server port (default: 8080)
# PORT=8080
