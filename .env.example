# JobTracker Environment Configuration
# Copy this file to .env and fill in what you want to use.
#
#   Windows PowerShell:  copy .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Every value here is optional. With no .env at all the app runs on the free
# sources (GitHub New Grad, company ATS boards, RemoteOK, The Muse, Remotive,
# Arbeitnow). Sources that need a key are reported in the UI as
# "Disabled — API credentials not configured" rather than silently returning
# zero jobs.
#
# .env is gitignored. Never commit real keys.
#
# PRECEDENCE, applied per setting:
#     this file / the environment  >  preference saved in the app  >  code default
# A value set here always wins. Anything left unset stays editable from the UI
# and is stored in the database.

# =============================================================================
# Job age policy — all measured against the SOURCE POSTING DATE, never against
# when we scraped or re-saw the job.
# =============================================================================
# Beyond this a stored posting is treated as expired and drops out of the lists.
MAX_JOB_AGE_DAYS=30
# Today only recommends postings younger than this.
TODAY_MAX_AGE_DAYS=14
# Still worth watching, but not a Today headline.
WATCH_MAX_AGE_DAYS=21
# Sources drop listings older than this at ingest time.
SCRAPE_MAX_AGE_DAYS=14

# =============================================================================
# Source switches — set any of these to false to turn a source off entirely.
# =============================================================================
ENABLE_GITHUB_NEWGRAD=true
ENABLE_GITHUB_INTERN=false
ENABLE_ATS=true
ENABLE_REMOTEOK=true
ENABLE_THEMUSE=true
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=true
ENABLE_ADZUNA=true
ENABLE_JSEARCH=true
ENABLE_LINKEDIN=false
# NUWorks uses NUWORKS_ENABLED (see the NUWorks section below).

# Per-source wall-clock budget, so one slow board cannot stall a whole run.
SOURCE_TIME_BUDGET_SECONDS=180

# =============================================================================
# Adzuna API (optional) — free ~1000 calls/month
# Get free credentials at: https://developer.adzuna.com/
# Leave blank and Adzuna reports itself as disabled.
# =============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
MAX_ADZUNA_CALLS=20

# =============================================================================
# JSearch / RapidAPI (optional) — free ~200 calls/month; use sparingly
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# =============================================================================
JSEARCH_API_KEY=
# JSEARCH_HOST=jsearch.p.rapidapi.com
# JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com/search
MAX_JSEARCH_CALLS=8

# =============================================================================
# NUWorks (Northeastern, Selenium + Duo login) — off by default
# This single switch gates the source registry, the scraper initialiser and
# the /api/nuworks routes. Credentials are also required.
# =============================================================================
NUWORKS_ENABLED=false
NUWORKS_USERNAME=
NUWORKS_PASSWORD=

# =============================================================================
# Search schedule
# The scheduler runs inside the Flask process: nothing is scraped while
# `python run.py` is not running.
# =============================================================================
SCHEDULE_ENABLED=true
# 'interval' -> every SCHEDULE_INTERVAL_HOURS; 'daily' -> at HOUR:MINUTE
SCHEDULE_MODE=interval
SCHEDULE_INTERVAL_HOURS=3
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=America/New_York

# How many top apply links to live-check after each run. Apply is only enabled
# for links that came back verified.
VERIFY_TOP_N=25
VERIFY_STALE_AFTER_HOURS=48

# Note: there is no email/SMTP implementation. Notifications are
# dashboard-only, so no SMTP settings are read.

# How many days after applying to surface a follow-up reminder.
FOLLOWUP_DAYS=7,14

# =============================================================================
# User Profile
# =============================================================================
# Path to your resume (used for reference, not uploaded anywhere)
RESUME_PATH=

# Default profile settings (used on first run)
DEFAULT_NAME=Job Seeker
DEFAULT_EMAIL=
DEFAULT_GITHUB_URL=
DEFAULT_LINKEDIN_URL=
DEFAULT_TARGET_ROLE=Data Engineer / Analytics Engineer — Full-Time New Grad

# =============================================================================
# Profile Matcher Configuration (Optional)
# =============================================================================
# Override skills and negative keywords as JSON:
# PROFILE_MATCHER_SKILLS='{"python": 15, "java": 10}'
# PROFILE_MATCHER_NEGATIVE_KEYWORDS='{"senior": -8}'
# PROFILE_MATCHER_MAX_SCORE=150

# =============================================================================
# Scoring weights — FINAL = 0.70 x candidate_match + 0.30 x opportunity,
# scaled by listing quality.
# =============================================================================
# CANDIDATE_MATCH_WEIGHT=0.70
# OPPORTUNITY_WEIGHT=0.30
# STRONG_MATCH_MIN=75
# EXCELLENT_MATCH_MIN=90
# BRIEFING_MAX_ROLE_TIER=2

# =============================================================================
# Application Settings
# =============================================================================
# Flask secret key. Leave blank for local-only use; the app logs a warning
# while it is unset. Generate one before exposing the app to any network:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database URL (default: SQLite in the instance folder)
# DATABASE_URL=sqlite:///jobs.db

# How long a writer waits for the SQLite lock before giving up.
# SQLITE_BUSY_TIMEOUT_SECONDS=30

# Server port (default: 8080)
# PORT=8080

# Max jobs returned by one /api/jobs page, whatever per_page asks for.
# MAX_PAGE_SIZE=200

# Flask debug mode. Leave off: it exposes the Werkzeug console, which is
# remote code execution for anyone who can reach the port, and the server
# binds 0.0.0.0. Opt in only for local debugging.
# FLASK_DEBUG=0
